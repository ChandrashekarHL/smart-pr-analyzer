# Copy to .env and fill in. Non-secret settings only: secrets are files in
# ./secrets (see DEPLOY.md), never values here.
# On the Spark (Option A): spark-5b23.tail75b36b.ts.net
PUBLIC_HOST=reviewer.example.com
GITHUB_APP_ID=123456
MODEL_API_URL=http://100.124.121.97:8100
BOT_LOGIN=prana-reviewer[bot]

# Review policy
MAX_HUNKS=8
TIME_BUDGET_S=25
MIN_CONFIDENCE=0.0
# Off: on test_ood the v1.1 model did not benefit from retrieved context.
RAG_ENABLED=0

# Dashboard at https://$PUBLIC_HOST/dashboard (basic auth). Make the hash with
#   docker compose run --rm caddy caddy hash-password
# and write any "$" in it as "$$" here, or compose will try to expand it.
DASHBOARD_USER=team
DASHBOARD_PASSWORD_HASH=
# Optional: a public Weights & Biases report to embed
WANDB_REPORT_URL=
